<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>円相 · Startup Grave (1080×1350)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;500;700;900&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:      #13120d;
    --paper:    #ece6d8;
    --paper-70: rgba(236,230,216,.68);
    --paper-40: rgba(236,230,216,.34);
    --brick:    #a6402c;
    --jade:     #4a6b5d;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ background:#000; display:flex; align-items:flex-start; justify-content:center; }
  .card{
    position:relative; width:1080px; height:1350px;
    background:
      radial-gradient(circle at 50% 14%, rgba(74,107,93,.16), transparent 45%),
      radial-gradient(ellipse at 50% 100%, rgba(0,0,0,.55), transparent 60%),
      var(--ink);
    overflow:hidden; font-family:'Inter', sans-serif; color:var(--paper);
  }
  .grain{ position:absolute; inset:0; opacity:.05; mix-blend-mode:overlay; pointer-events:none; }
  .brand{ position:absolute; top:56px; left:64px; display:flex; align-items:center; gap:14px; }
  .brand .glyph{ font-size:28px; line-height:1; color:var(--paper); }
  .brand .word{ font-family:'JetBrains Mono', monospace; font-size:17px; letter-spacing:.3em; color:var(--paper-70); text-transform:uppercase; }
  .eyebrow{ position:absolute; top:60px; right:64px; font-family:'JetBrains Mono', monospace; font-size:17px; letter-spacing:.26em; color:var(--brick); text-transform:uppercase; }

  .stat-frame{ position:absolute; top:150px; left:50%; transform:translateX(-50%); width:400px; height:400px; }
  .stat-fill{
    position:absolute; inset:0; border-radius:50%;
    background: linear-gradient(155deg, var(--brick) 0%, var(--jade) 100%);
    display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
  }
  .stat-fill .num{ font-family:'Unbounded', sans-serif; font-weight:900; font-size:82px; line-height:1; color:var(--ink); letter-spacing:-.02em; }
  .stat-fill .lbl{ margin-top:12px; font-family:'JetBrains Mono', monospace; font-size:16px; letter-spacing:.18em; color:rgba(19,18,13,.62); text-transform:uppercase; }
  .stat-ring-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; pointer-events:none; }

  .content{ position:absolute; top:610px; left:64px; right:64px; }
  .stats{ display:flex; align-items:center; justify-content:flex-start; gap:22px; font-family:'JetBrains Mono', monospace; font-size:20px; color:var(--paper-70); margin-bottom:26px; text-align:left; }
  .stats .flag{ color:var(--brick); }
  .stats .sep{ color:var(--paper-40); }
  .stats .meta{ color:var(--paper-70); }
  .project-name{ font-family:'Unbounded', sans-serif; font-weight:700; font-size:50px; line-height:1.1; letter-spacing:-.01em; color:var(--paper); text-align:left; }
  .tagline{ margin-top:16px; font-size:23px; font-weight:400; color:var(--paper-70); line-height:1.45; text-align:left; }
  .divider{ margin:32px 0 26px; height:1px; background:linear-gradient(90deg, transparent, var(--paper-40) 50%, transparent); }
  .desc{ font-size:23px; line-height:1.55; color:var(--paper); text-align:justify; text-justify:inter-word; }
  .desc p + p{ margin-top:12px; }

  .tagstrip{ margin-top:28px; background:rgba(236,230,216,.045); border:1px solid rgba(236,230,216,.14); border-radius:14px; padding:20px 24px; display:flex; align-items:center; gap:14px; max-width:940px; }
  .tagstrip .dot{ width:10px; height:10px; border-radius:50%; background:var(--brick); flex:none; }
  .tagstrip .txt{ font-family:'JetBrains Mono', monospace; font-size:17px; color:var(--paper-70); }
  .tagstrip .txt b{ color:var(--paper); }

  .footer{ position:absolute; bottom:56px; left:64px; right:64px; display:flex; align-items:center; justify-content:space-between; font-family:'JetBrains Mono', monospace; font-size:16px; letter-spacing:.09em; color:var(--paper-40); text-transform:uppercase; }
  .footer .rule{ flex:1; height:1px; background:var(--paper-40); margin:0 20px; }
</style>
</head>
<body>
<div class="card">
  <svg class="grain" viewBox="0 0 1080 1350">
    <filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#n)"/>
  </svg>

  <div class="brand"><span class="glyph">円相</span><span class="word">Enso</span></div>
  <div class="eyebrow">☠ Провал</div>

  <div class="stat-frame">
    <div class="stat-fill">
      <span class="num">{{ stat_num }}</span>
      <span class="lbl">{{ stat_label }}</span>
    </div>
    <img class="stat-ring-img" src="{{ ring_data_uri }}" alt="enso ring">
  </div>

  <div class="content">
    <div class="stats">
      {% if flag %}<span class="flag">{{ flag }}</span><span class="sep">·</span>{% endif %}
      <span class="meta">{{ years }}</span>
      <span class="sep">·</span>
      <span class="meta">{{ sector }}</span>
    </div>

    <div class="project-name">{{ project_name }}</div>
    <div class="tagline">{{ tagline }}</div>

    {% if desc_paragraph %}
    <div class="divider"></div>
    <div class="desc"><p>{{ desc_paragraph }}</p></div>
    {% endif %}

    {% if cause %}
    <div class="tagstrip">
      <span class="dot"></span>
      <span class="txt">ПРИЧИНА <b>{{ cause }}</b></span>
    </div>
    {% endif %}
  </div>

  <div class="footer">
    {% if is_batch %}
    <span>円相 · разбор провала</span>
    <span class="rule"></span>
    <span>{{ index }} / {{ total }}</span>
    {% else %}
    <span class="rule" style="margin:0;"></span>
    {% endif %}
  </div>
</div>
</body>
</html>
