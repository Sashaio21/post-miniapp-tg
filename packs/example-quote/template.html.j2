<!doctype html><html><head><meta charset="utf-8"><style>
*{box-sizing:border-box;margin:0}body{width:1080px;height:1080px;background:#111}
.card{width:1080px;height:1080px;padding:100px;display:flex;flex-direction:column;justify-content:center;background:{{ bg|default("#1d1c17") }};color:#ece6d8;font-family:Georgia,serif}
.q{font-size:76px;line-height:1.15}.a{margin-top:56px;font:600 34px/1 "Helvetica Neue",Arial,sans-serif;color:{{ accent|default("#d4674f") }};letter-spacing:.06em;text-transform:uppercase}
</style></head><body><div class="card"><div class="q">«{{ text }}»</div><div class="a">— {{ author }}</div></div></body></html>
