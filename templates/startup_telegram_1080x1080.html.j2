<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>円相 · Startup Grave — Telegram (1080×1080)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;500;700;900&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:      #13120d;
    --paper:    #ece6d8;
    --paper-70: rgba(236,230,216,.68);
    --paper-40: rgba(236,230,216,.34);
    --brick:    #a6402c;
    --jade:     #4a6b5d;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ background:#000; display:flex; align-items:flex-start; justify-content:center; }
  .card{
    position:relative; width:1080px; height:1080px;
    background:
      radial-gradient(circle at 50% 14%, rgba(74,107,93,.16), transparent 45%),
      radial-gradient(ellipse at 50% 100%, rgba(0,0,0,.5), transparent 60%),
      var(--ink);
    overflow:hidden; font-family:'Inter', sans-serif; color:var(--paper);
  }
  .grain{ position:absolute; inset:0; opacity:.05; mix-blend-mode:overlay; pointer-events:none; }
  .brand{ position:absolute; top:60px; left:64px; display:flex; align-items:center; gap:14px; }
  .brand .glyph{ font-size:28px; line-height:1; color:var(--paper); }
  .brand .word{ font-family:'JetBrains Mono', monospace; font-size:17px; letter-spacing:.3em; color:var(--paper-70); text-transform:uppercase; }
  .eyebrow{ position:absolute; top:64px; right:64px; font-family:'JetBrains Mono', monospace; font-size:17px; letter-spacing:.26em; color:var(--brick); text-transform:uppercase; }

  /* the enso ring frames the headline figure — a failed startup has no
     screenshot to show, so the sharpest fact takes the photo's place */
  .stat-frame{ position:absolute; top:140px; left:50%; transform:translateX(-50%); width:500px; height:500px; }
  .stat-fill{
    position:absolute; inset:0; border-radius:50%;
    background: linear-gradient(155deg, var(--brick) 0%, var(--jade) 100%);
    display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
  }
  .stat-fill .num{ font-family:'Unbounded', sans-serif; font-weight:900; font-size:104px; line-height:1; color:var(--ink); letter-spacing:-.02em; }
  .stat-fill .lbl{ margin-top:16px; font-family:'JetBrains Mono', monospace; font-size:19px; letter-spacing:.18em; color:rgba(19,18,13,.62); text-transform:uppercase; }
  .stat-ring-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; pointer-events:none; }

  .content{ position:absolute; top:670px; left:64px; right:64px; }
  .stats{ display:flex; align-items:center; justify-content:flex-start; gap:22px; font-family:'JetBrains Mono', monospace; font-size:20px; color:var(--paper-70); margin-bottom:28px; text-align:left; }
  .stats .flag{ color:var(--brick); }
  .stats .sep{ color:var(--paper-40); }
  .stats .meta{ color:var(--paper-70); }
  .project-name{ font-family:'Unbounded', sans-serif; font-weight:700; font-size:52px; line-height:1.1; letter-spacing:-.01em; color:var(--paper); text-align:left; }
  .tagline{ margin-top:16px; font-size:24px; font-weight:400; color:var(--paper-70); line-height:1.45; text-align:left; }

  .bg-ring{ position:absolute; bottom:-260px; right:-260px; width:640px; height:640px; border-radius:50%; border:2px solid var(--paper); opacity:.055; pointer-events:none; }
</style>
</head>
<body>
<div class="card">
  <svg class="grain" viewBox="0 0 1080 1080">
    <filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#n)"/>
  </svg>

  <div class="bg-ring"></div>

  <div class="brand"><span class="glyph">円相</span><span class="word">Enso</span></div>
  <div class="eyebrow">☠ Провал</div>

  <div class="stat-frame">
    <div class="stat-fill">
      <span class="num">{{ stat_num }}</span>
      <span class="lbl">{{ stat_label }}</span>
    </div>
    <img class="stat-ring-img" src="{{ ring_data_uri }}" alt="enso ring">
  </div>

  <div class="content">
    <div class="stats">
      {% if flag %}<span class="flag">{{ flag }}</span><span class="sep">·</span>{% endif %}
      <span class="meta">{{ years }}</span>
      <span class="sep">·</span>
      <span class="meta">{{ sector }}</span>
    </div>

    <div class="project-name">{{ project_name }}</div>
    <div class="tagline">{{ tagline }}</div>
  </div>
</div>
</body>
</html>
