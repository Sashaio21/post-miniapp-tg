<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>円相 · Startup Grave (1080×1920)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;500;700;900&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:      #13120d;
    --paper:    #ece6d8;
    --paper-70: rgba(236,230,216,.68);
    --paper-40: rgba(236,230,216,.34);
    --brick:    #a6402c;
    --jade:     #4a6b5d;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ background:#000; display:flex; align-items:flex-start; justify-content:center; }
  .card{
    position:relative; width:1080px; height:1920px;
    background:
      radial-gradient(circle at 50% 18%, rgba(74,107,93,.16), transparent 45%),
      radial-gradient(ellipse at 50% 100%, rgba(0,0,0,.55), transparent 60%),
      var(--ink);
    overflow:hidden; font-family:'Inter', sans-serif; color:var(--paper);
  }
  .grain{ position:absolute; inset:0; opacity:.05; mix-blend-mode:overlay; pointer-events:none; }
  .brand{ position:absolute; top:76px; left:76px; display:flex; align-items:center; gap:16px; }
  .brand .glyph{ font-size:34px; line-height:1; color:var(--paper); }
  .brand .word{ font-family:'JetBrains Mono', monospace; font-size:20px; letter-spacing:.32em; color:var(--paper-70); text-transform:uppercase; }
  .eyebrow{ position:absolute; top:80px; right:76px; font-family:'JetBrains Mono', monospace; font-size:20px; letter-spacing:.28em; color:var(--brick); text-transform:uppercase; }

  .stat-frame{ position:absolute; top:280px; left:50%; transform:translateX(-50%); width:520px; height:520px; }
  .stat-fill{
    position:absolute; inset:0; border-radius:50%;
    background: linear-gradient(155deg, var(--brick) 0%, var(--jade) 100%);
    display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
  }
  .stat-fill .num{ font-family:'Unbounded', sans-serif; font-weight:900; font-size:108px; line-height:1; color:var(--ink); letter-spacing:-.02em; }
  .stat-fill .lbl{ margin-top:16px; font-family:'JetBrains Mono', monospace; font-size:20px; letter-spacing:.18em; color:rgba(19,18,13,.62); text-transform:uppercase; }
  .stat-ring-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:contain; pointer-events:none; }

  .content{ position:absolute; top:900px; left:76px; right:76px; }
  .stats{ display:flex; align-items:center; justify-content:flex-start; gap:28px; font-family:'JetBrains Mono', monospace; font-size:24px; color:var(--paper-70); margin-bottom:40px; text-align:left; }
  .stats .flag{ color:var(--brick); }
  .stats .sep{ color:var(--paper-40); }
  .stats .meta{ color:var(--paper-70); }
  .project-name{ font-family:'Unbounded', sans-serif; font-weight:700; font-size:64px; line-height:1.08; letter-spacing:-.01em; color:var(--paper); }
  .tagline{ margin-top:22px; font-size:28px; font-weight:400; color:var(--paper-70); line-height:1.45; }
  .divider{ margin:44px 0 38px; height:1px; background:linear-gradient(90deg, var(--paper-40), transparent 70%); }
  .desc{ font-size:29px; line-height:1.6; color:var(--paper); text-align:justify; text-justify:inter-word; }
  .desc p + p{ margin-top:14px; }

  .tagstrip{ margin-top:40px; background:rgba(236,230,216,.045); border:1px solid rgba(236,230,216,.14); border-radius:14px; padding:22px 26px; display:flex; align-items:center; gap:14px; max-width:900px; }
  .tagstrip .dot{ width:11px; height:11px; border-radius:50%; background:var(--brick); flex:none; }
  .tagstrip .txt{ font-family:'JetBrains Mono', monospace; font-size:20px; color:var(--paper-70); }
  .tagstrip .txt b{ color:var(--paper); }

  .footer{ position:absolute; bottom:76px; left:76px; right:76px; display:flex; align-items:center; justify-content:space-between; font-family:'JetBrains Mono', monospace; font-size:19px; letter-spacing:.1em; color:var(--paper-40); text-transform:uppercase; }
  .footer .rule{ flex:1; height:1px; background:var(--paper-40); margin:0 24px; }
</style>
</head>
<body>
<div class="card">
  <svg class="grain" viewBox="0 0 1080 1920">
    <filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/></filter>
    <rect width="100%" height="100%" filter="url(#n)"/>
  </svg>

  <div class="brand"><span class="glyph">円相</span><span class="word">Enso</span></div>
  <div class="eyebrow">☠ Провал</div>

  <div class="stat-frame">
    <div class="stat-fill">
      <span class="num">{{ stat_num }}</span>
      <span class="lbl">{{ stat_label }}</span>
    </div>
    <img class="stat-ring-img" src="{{ ring_data_uri }}" alt="enso ring">
  </div>

  <div class="content">
    <div class="stats">
      {% if flag %}<span class="flag">{{ flag }}</span><span class="sep">·</span>{% endif %}
      <span class="meta">{{ years }}</span>
      <span class="sep">·</span>
      <span class="meta">{{ sector }}</span>
    </div>

    <div class="project-name">{{ project_name }}</div>
    <div class="tagline">{{ tagline }}</div>

    {% if desc_paragraph %}
    <div class="divider"></div>
    <div class="desc"><p>{{ desc_paragraph }}</p></div>
    {% endif %}

    {% if cause %}
    <div class="tagstrip">
      <span class="dot"></span>
      <span class="txt">ПРИЧИНА <b>{{ cause }}</b></span>
    </div>
    {% endif %}
  </div>

  <div class="footer">
    {% if is_batch %}
    <span>円相 · разбор провала</span>
    <span class="rule"></span>
    <span>{{ index }} / {{ total }}</span>
    {% else %}
    <span class="rule" style="margin:0;"></span>
    {% endif %}
  </div>
</div>
</body>
</html>
